/* ProIngest dark theme. UI_SPEC preamble: near-black panels, thin 1px separators,
   muted grey text, one accent for selection and primary actions, amber for warnings,
   red for errors, green for done. No gradients, no shadows, no rounded cards.

   The palette is stated once here and nowhere else. Qt stylesheets have no variables,
   so the hex values repeat; the names they stand for are:

     ground  #0e0f12   the window behind everything
     panel   #15171b   docks, toolbar, status bar
     raised  #1b1e23   headers, tab bars, controls
     line    #262a31   every separator
     text    #ced3db   normal text
     dim     #868d9a   secondary text
     accent  #4d8fd6   selection and primary actions
     warn    #cf9a3a   amber, done    #58a97a  green, error #cf5a52  red

   Row tints and the status dot (UI_SPEC section 3) are painted by the shot list's
   delegate rather than here, because they vary per row and a stylesheet cannot see a
   model. The three state colours are listed above so both ends agree on them. */

QMainWindow, QDialog {
  background: #0e0f12;
}

QWidget {
  color: #ced3db;
  font-size: 13px;
}

QMenuBar, QToolBar, QStatusBar, QDockWidget {
  background: #15171b;
  border: 0;
}

QToolBar {
  border-bottom: 1px solid #262a31;
  padding: 4px 6px;
  spacing: 4px;
}

QToolBar::separator {
  background: #262a31;
  width: 1px;
  margin: 4px 8px;
}

QStatusBar {
  border-top: 1px solid #262a31;
  color: #868d9a;
}

QMenuBar::item:selected, QMenu::item:selected {
  background: #4d8fd6;
  color: #0e0f12;
}

QMenu {
  background: #1b1e23;
  border: 1px solid #262a31;
}

QToolButton, QPushButton {
  background: #1b1e23;
  border: 1px solid #262a31;
  padding: 5px 12px;
}

QToolButton:hover, QPushButton:hover {
  border-color: #333944;
}

QToolButton:pressed, QPushButton:pressed {
  background: #4d8fd6;
  color: #0e0f12;
}

QToolButton:disabled, QPushButton:disabled {
  color: #5c626d;
  border-color: #1b1e23;
}

QDockWidget {
  titlebar-close-icon: none;
  titlebar-normal-icon: none;
}

QDockWidget::title {
  background: #1b1e23;
  border-top: 1px solid #262a31;
  padding: 5px 8px;
  color: #868d9a;
}

QTabWidget::pane {
  border-top: 1px solid #262a31;
}

QTabBar::tab {
  background: #15171b;
  color: #868d9a;
  border: 0;
  border-right: 1px solid #262a31;
  padding: 6px 14px;
}

QTabBar::tab:selected {
  color: #ced3db;
  border-bottom: 2px solid #4d8fd6;
}

QProgressBar {
  background: #1b1e23;
  border: 1px solid #262a31;
  text-align: center;
  color: #868d9a;
  height: 14px;
}

QProgressBar::chunk {
  background: #4d8fd6;
}

#empty_state_text {
  color: #868d9a;
  font-size: 16px;
}

/* ---- the shot list (UI_SPEC section 2) ---- */

QTreeView {
  background: #0e0f12;
  alternate-background-color: #0e0f12;
  border: 0;
  outline: 0;
  selection-background-color: #1f3c5c;
  selection-color: #eef1f5;
}

QTreeView::item {
  border-bottom: 1px solid #15171b;
  padding: 2px 4px;
}

QTreeView::item:selected {
  background: #1f3c5c;
  color: #eef1f5;
}

QHeaderView::section {
  background: #1b1e23;
  color: #868d9a;
  border: 0;
  border-right: 1px solid #262a31;
  border-bottom: 1px solid #262a31;
  padding: 5px 6px;
}

/* ---- the batch bar ---- */

#batch_bar {
  background: #15171b;
  border-bottom: 1px solid #262a31;
}

#batch_name {
  color: #ced3db;
  font-weight: 600;
}

#batch_bar QPushButton {
  padding: 3px 10px;
}

#batch_bar QPushButton:checked {
  background: #1f3c5c;
  border-color: #4d8fd6;
  color: #eef1f5;
}

QLineEdit {
  background: #1b1e23;
  border: 1px solid #262a31;
  padding: 4px 8px;
  color: #ced3db;
  selection-background-color: #4d8fd6;
}

QLineEdit:focus {
  border-color: #4d8fd6;
}

/* ---- the strip above the list (UI_SPEC sections 7 and 7.1) ---- */

/* #run_strip itself is unstyled: it is the frame the two states sit in, and each of
   them carries the background and the rule under it so that whichever is showing looks
   like one band rather than two. */

#run_strip_progress {
  background: #1b1e23;
  border-bottom: 1px solid #262a31;
}

#run_strip_bar {
  background: #2b2f36;
  border: none;
}

#run_strip_bar::chunk {
  background: #4d8fd6;
}

#run_strip_line {
  color: #868d9a;
  padding: 6px 10px 7px;
}

#run_banner {
  background: #1b1e23;
  border-bottom: 1px solid #262a31;
  color: #ced3db;
  padding: 7px 10px;
}

/* ---- the metadata pane (UI_SPEC section 12) ---- */

#metadata_pane, #metadata_scroll, #metadata_scroll > QWidget > QWidget {
  background: #15171b;
}

#metadata_top {
  background: #1b1e23;
  border-bottom: 1px solid #262a31;
}

#metadata_summary {
  color: #ced3db;
}

#metadata_placeholder {
  color: #5c626d;
  padding: 20px;
}

#metadata_copy_all {
  background: transparent;
  border: 0;
  color: #868d9a;
  padding: 2px 6px;
}

#metadata_copy_all:hover, #metadata_copy:hover {
  color: #4d8fd6;
}

/* The header is a full width band rather than a button shape: it is a disclosure
   triangle and a title, and a raised button there reads as an action. */
#metadata_section_header {
  background: #1b1e23;
  border: 0;
  border-top: 1px solid #262a31;
  border-bottom: 1px solid #262a31;
  color: #868d9a;
  font-weight: 600;
  padding: 5px 8px;
  text-align: left;
}

#metadata_section_header:hover {
  color: #ced3db;
}

#metadata_section_body {
  background: #15171b;
}

#metadata_label {
  color: #5c626d;
}

#metadata_value {
  color: #ced3db;
}

#metadata_copy {
  background: transparent;
  border: 0;
  color: #5c626d;
  padding: 0 4px;
}

/* ---- the Settings page (UI_SPEC section 9) ---- */

/* The section list is the page's spine, so it takes the panel ground rather than the
   raised one every other control has: it is a place in the window, not a control. */
#settings_sections {
  background: #15171b;
  border: 0;
  border-right: 1px solid #262a31;
  outline: 0;
  padding: 6px 0;
}

#settings_sections::item {
  padding: 6px 12px;
}

#settings_sections::item:selected {
  background: #1b1e23;
  border-left: 2px solid #4d8fd6;
  color: #ced3db;
}

/* Help lines sit under the field they explain, so they are quieter than a label and
   never the same weight as a value. */
#settings_note {
  color: #5c626d;
}

/* A value the tool states rather than takes. Monospaced because two of the three are
   library names that get pasted into a message, and a name read wrong is worse than a
   name read slowly. */
#settings_readonly {
  color: #868d9a;
  font-family: "SF Mono", Menlo, monospace;
  font-size: 12px;
}

QSpinBox, QPlainTextEdit {
  background: #1b1e23;
  border: 1px solid #262a31;
  padding: 3px 6px;
  color: #ced3db;
  selection-background-color: #4d8fd6;
}

QSpinBox:focus, QPlainTextEdit:focus {
  border-color: #4d8fd6;
}

/* Qt draws an unstyled checkbox in the platform's own colours, which on the near-black
   ground is a white square that reads as the brightest thing on the page. */
QCheckBox::indicator {
  background: #1b1e23;
  border: 1px solid #333944;
  height: 12px;
  width: 12px;
}

QCheckBox::indicator:checked {
  background: #4d8fd6;
  border-color: #4d8fd6;
}

QSpinBox::up-button, QSpinBox::down-button {
  background: #262a31;
  border: 0;
  width: 14px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
  background: #333944;
}
